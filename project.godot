; Engine configuration file.
; Neon Velocity — procedural retro side-scrolling shooter.
; Generated project. All art and audio are produced at runtime, so the
; repository ships zero binary assets.

config_version=5

[application]

config/name="Neon Velocity"
config/description="A retro side-scrolling shooter. All sprites and audio are generated procedurally at runtime."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/EventBus.gd"
SaveSystem="*res://scripts/core/SaveSystem.gd"
Art="*res://scripts/core/Art.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
ObjectPool="*res://scripts/core/ObjectPool.gd"
WeaponSystem="*res://scripts/systems/WeaponSystem.gd"
LevelManager="*res://scripts/systems/LevelManager.gd"
GameManager="*res://scripts/systems/GameManager.gd"
ReplaySystem="*res://scripts/systems/ReplaySystem.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

